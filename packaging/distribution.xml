<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>DevTasks</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <options customize="never" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_localSystem="true"/>
    <volume-check>
        <allowed-os-versions><os-version min="14.0"/></allowed-os-versions>
    </volume-check>
    <choices-outline>
        <line choice="default"><line choice="dev.local.devtasks.pkg"/></line>
    </choices-outline>
    <choice id="default"/>
    <choice id="dev.local.devtasks.pkg" visible="false">
        <pkg-ref id="dev.local.devtasks.pkg"/>
    </choice>
    <pkg-ref id="dev.local.devtasks.pkg" version="__VERSION__" onConclusion="none">DevTasks-component.pkg</pkg-ref>
</installer-gui-script>
